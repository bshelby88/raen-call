    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "x402",
    "payments",
    "usdc",
    "base",
    "http-402",
    "micropayments",
    "ai-agents",
    "api",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bshelby88/raen-call.git"
  },
  "homepage": "https://github.com/bshelby88/raen-call#readme",
  "bugs": {
    "url": "https://github.com/bshelby88/raen-call/issues"
  },
  "dependencies": {
    "@x402/core": "^2.30.0",
    "@x402/evm": "^2.30.0",
    "@x402/fetch": "^2.30.0",
    "viem": "^2.0.0"
  }
}
